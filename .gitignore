# Dependencies and build output
node_modules/
.pnpm-store/
dist/
.vite/
tsconfig.tsbuildinfo
*.tsbuildinfo

# Secrets (backend/.env.example stays tracked as the template)
.env
.env.*
.env.local
.env.*.local
!.env.example
!backend/.env.example
*.pem
*.key

# Every dot-directory: editor, agent, tool and MCP state
# (.claude, .playwright-mcp, .vscode, .idea, .agents, .cursor, ...)
.*/
# Local MCP / tool config files
.mcp.json
skills-lock.json
/skills/

# Internal docs and working notes are not part of the repo
docs/

# Python backend
__pycache__/
*.py[cod]
*$py.class
venv/
.venv/
backend/.venv/
backend/.venv-voice/
backend/samples/*.wav

# Logs and OS junk
*.log
verify.log
.DS_Store
Thumbs.db
desktop.ini

# Local AI-assistant notes and any chat transcripts never leave this machine
CLAUDE.md
*.jsonl

# Tracked Gemini & Cloud Run governance and deployment configs
!GEMINI.md
!DEPLOY.md
!.gcloudignore
!.agents/
!.agents/rules/
!.agents/rules/**
