# Copy to `backend/.env.local` and fill in. Restart the server after editing.
# .env.local is gitignored. Never commit keys; the browser never sees them.

# Google Gemini API (https://aistudio.google.com/)
GEMINI_API_KEY=
PATIENT_LLM_PROVIDER=gemini
GEMINI_FAST_MODEL=gemini-3.5-flash-lite
GEMINI_REASONING_MODEL=gemini-3.8-flash
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
GEMINI_EFFORT_CAP=medium

# Cloud Run / Server Deployment Configuration
MEDSIM_SHARED_SECRET=
MEDSIM_ALLOWED_ORIGINS=http://localhost:5173

# OPTIONAL: send the prescription + voice link + follow-up to the patient (free tiers only).
# Twilio WhatsApp sandbox / trial SMS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Sandbox sender, defaults to +14155238886
TWILIO_WHATSAPP_FROM=
# Only for SMS (a Twilio trial number)
TWILIO_SMS_FROM=
# Observer phone call: caller ID for Twilio Calls API
TWILIO_VOICE_FROM=
# Optional: Twilio Content template SID for WhatsApp (required on trial accounts)
TWILIO_WHATSAPP_CONTENT_SID=

# Email via SMTP over SSL (Gmail: use an app password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# Defaults to SMTP_USER
SMTP_FROM=

# Telegram (free, recommended for the demo): create a bot with @BotFather and paste its token.
# The patient opens t.me/<your_bot>?start=medsim and presses Start; then contact "telegram" works.
TELEGRAM_BOT_TOKEN=
# The same bot also delivers consultation results (POST /agent/results/send): a summary,
# a one-page PDF report card and a voice summary. No extra keys needed.
# The same bot also authors patients (/newpatient) by long polling getUpdates.
# Set to 0 to turn the poller off (e.g. when a second server shares the token).
# TELEGRAM_BOT_POLLING=1
# Base URL of the web app in the bot's "open this patient" links (default http://localhost:5173).
# APP_URL=
# Telegram-created cases are kept here (default: OS temp dir, "off" = memory only).
# CUSTOM_CASES_FILE=
# Where Asha's live red-flag alerts go during a follow-up call: "telegram", tg:<chat id>,
# a phone (E.164) or an email. Blank = the patient's contact on file.
DOCTOR_ALERT_DEST=

# Optional lip-synced video avatar for the teacher and viva examiner.
# Leave blank to keep the 3D teacher / pixel examiner. Free no-card key: https://lab.anam.ai
# (Anam free plan, 30 min/month). Vendor: anam | liveavatar | akool.
AVATAR_VENDOR=
AVATAR_API_KEY=
# Avatar id from the vendor's gallery or dashboard
AVATAR_ID=
# high | medium | low (anam, liveavatar)
AVATAR_QUALITY=
